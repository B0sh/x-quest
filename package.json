{
  "name": "x-quest",
  "version": "1.5.0",
  "description": "You are an X that goes on a quest.",
  "repository": {
    "type": "git",
    "url": "https://github.com/B0sh/x-quest"
  },
  "scripts": {
    "clean": "rimraf dist backend/dist",
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "parcel index.html",
    "dev:server": "tsx watch backend/src/server.ts",
    "build:client": "parcel build index.html",
    "build:server": "tsc -p backend/tsconfig.json",
    "build": "npm run clean && npm run build:client && npm run build:server",
    "start": "node backend/dist/server.js"
  },
  "author": "Walden Perry",
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "express": "^5.2.1",
    "howler": "^2.2.4",
    "rot-js": "^2.2.1",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/howler": "^2.2.12",
    "concurrently": "^9.2.1",
    "parcel": "^2.16.4",
    "parcel-reporter-static-files-copy": "^1.5.3",
    "process": "^0.11.10",
    "rimraf": "^6.0.3",
    "tsx": "^4.22.0",
    "typescript": "^6.0.3"
  }
}
